---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import site from '../data/site.json';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: object | null;
}
const { title, description, noindex = false, schema = null } = Astro.props;
const live = process.env.LIVE === '1';
const robots = !live || noindex ? 'noindex, nofollow' : 'index, follow';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-frueh-systems.jpg', Astro.site).href;
const year = new Date().getFullYear();

const nav = [
  { href: '/#leistungen', label: 'Leistungen' },
  { href: '/#preise', label: 'Preise' },
  { href: '/#ueber-mich', label: 'Über mich' },
];
---
<!doctype html>
<html lang="de-CH">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#0a1024" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="de_CH" />
  <meta property="og:site_name" content="Früh Systems" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Früh Systems, persönlicher IT-Support von Nick Früh" />
  <meta name="twitter:card" content="summary_large_image" />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>
  <a class="skip" href="#main">Zum Inhalt springen</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="brand" aria-label="Früh Systems, zur Startseite">
        <Image src={logo} alt="Früh Systems" width={170} densities={[1, 2]} loading="eager" />
      </a>
      <nav class="main-nav" aria-label="Hauptnavigation">
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="header-actions">
        <a class="btn header-phone" href={site.phoneHref} aria-label={`Anrufen: ${site.phoneDisplay}`}>
          <Icon name="phone" /><span class="header-phone-nr">{site.phoneDisplay}</span>
        </a>
        <a class="btn btn-primary header-cta" href="/#anfrage">Anfrage senden</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
          <span class="visually-hidden">Menü öffnen</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
    </div>
    <div class="mobile-menu" id="mobile-menu" hidden>
      <nav class="wrap" aria-label="Mobile Navigation">
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/#anfrage">Anfrage senden</a></li>
        </ul>
        <div class="mobile-contact">
          <a class="btn btn-primary" href={site.phoneHref}>Anrufen: {site.phoneDisplay}</a>
          <a class="btn btn-ghost" href={site.whatsapp} rel="noopener">WhatsApp schreiben</a>
        </div>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <Image src={logo} alt="" width={1200} widths={[600, 1200]} sizes="(max-width: 1200px) 92vw, 1150px" class="footer-mark" />
      <div class="footer-grid">
        <div>
          <Image src={logo} alt="Früh Systems" width={150} densities={[1, 2]} class="footer-logo" />
          <p class="muted small">Persönliche IT. Klare Lösungen.</p>
        </div>
        <div>
          <h2 class="footer-h">Kontakt</h2>
          <ul class="footer-list">
            <li><a href={site.phoneHref}>{site.phoneDisplay}</a></li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><a href={site.whatsapp} rel="noopener">WhatsApp</a></li>
          </ul>
        </div>
        <div>
          <h2 class="footer-h">Adresse</h2>
          <p class="small">{site.street}<br />{site.zip} {site.city}</p>
        </div>
        <div>
          <h2 class="footer-h">Rechtliches</h2>
          <ul class="footer-list">
            <li><a href="/impressum/">Impressum</a></li>
            <li><a href={site.privacyUrl}>Datenschutz</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom small muted">
        <p>© {year} Früh Systems</p>
        <p>Website von <a href="https://bilegflow.ch">Bilegflow</a></p>
      </div>
    </div>
  </footer>

  <div class="quickbar" aria-label="Schnellkontakt">
    <a href={site.phoneHref}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" fill="currentColor"/></svg>
      Anrufen
    </a>
    <a href={site.whatsapp} rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.25-.12-1.47-.72-1.7-.8-.22-.09-.39-.13-.55.12-.17.25-.64.8-.78.97-.15.16-.29.18-.54.06a6.7 6.7 0 0 1-3.34-2.92c-.25-.43.25-.4.72-1.34.08-.16.04-.3-.02-.42l-.75-1.82c-.2-.48-.4-.41-.55-.42h-.47a.9.9 0 0 0-.65.3 2.75 2.75 0 0 0-.86 2.04 4.8 4.8 0 0 0 1 2.53 10.9 10.9 0 0 0 4.18 3.7c1.56.67 2.17.73 2.95.62.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29z" fill="currentColor"/></svg>
      WhatsApp
    </a>
    <a href="/#anfrage">Anfrage</a>
  </div>

  <script>
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (toggle && menu) {
      const label = toggle.querySelector('.visually-hidden');
      const set = (open: boolean) => {
        toggle.setAttribute('aria-expanded', String(open));
        menu.hidden = !open;
        document.body.classList.toggle('menu-open', open);
        if (label) label.textContent = open ? 'Menü schliessen' : 'Menü öffnen';
      };
      toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
      menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { set(false); toggle.focus(); }
      });
      matchMedia('(min-width: 961px)').addEventListener('change', (m) => { if (m.matches) set(false); });
    }
  </script>
</body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50; padding-top: var(--s-3);
    margin-bottom: calc(-4.25rem - var(--s-3));
  }
  .header-inner {
    display: flex; align-items: center; gap: var(--s-5); min-height: 4.25rem;
    padding-inline: var(--s-5) var(--s-2);
    background: color-mix(in srgb, #fff 94%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    border: 1px solid rgb(255 255 255 / 0.6); border-radius: 18px;
    box-shadow: 0 10px 30px -18px rgb(10 16 36 / 0.5);
  }
  .brand img { width: 150px; height: auto; }
  .main-nav { margin-left: auto; }
  .main-nav ul { display: flex; gap: var(--s-5); list-style: none; }
  .main-nav a { text-decoration: none; font-weight: 500; color: var(--ink-2); padding-block: var(--s-2); }
  .main-nav a:hover { color: var(--ink); text-decoration: underline; }
  .header-actions { display: flex; align-items: center; gap: var(--s-2); }
  .header-phone {
    min-height: 44px; padding: 0 1.05rem; border-color: var(--line); background: #fff; color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .header-phone:hover { border-color: var(--ink); }
  .header-phone :global(svg) { width: 1.05em; height: 1.05em; color: var(--green-ink); }
  .header-cta { min-height: 44px; }
  .menu-toggle {
    display: none; width: 44px; height: 44px; border: 1.5px solid var(--line); border-radius: 50%;
    background: #fff; color: var(--ink); cursor: pointer; padding: 10px;
  }
  .mobile-menu {
    margin-top: var(--s-2); background: #fff; border-radius: 18px; border: 1px solid var(--line);
    width: min(100% - 2 * var(--gutter), var(--wrap)); margin-inline: auto;
    padding-block: var(--s-4) var(--s-5);
    max-height: calc(100dvh - 6rem); overflow-y: auto;
    box-shadow: 0 20px 40px -20px rgb(10 16 36 / 0.4);
  }
  .mobile-menu .wrap { width: auto; padding-inline: var(--s-5); }
  .mobile-menu ul { list-style: none; display: grid; }
  .mobile-menu li a {
    display: block; padding: var(--s-3) 0; font-size: var(--t-md); font-weight: 600;
    text-decoration: none; border-bottom: 1px solid var(--line);
  }
  .mobile-contact { display: grid; gap: var(--s-3); margin-top: var(--s-5); }
  :global(body.menu-open) { overflow: hidden; }

  @media (max-width: 960px) {
    .main-nav, .header-cta { display: none; }
    .header-actions { margin-left: auto; }
    .menu-toggle { display: grid; place-items: center; }
  }
  @media (max-width: 520px) {
    .header-inner { padding-inline: var(--s-4) var(--s-2); }
    .header-phone { width: 44px; padding: 0; }
    .header-phone-nr { display: none; }
    .brand img { width: 132px; }
  }

  .site-footer { padding-top: var(--s-8); }
  .site-footer :global(.footer-mark) { width: 100%; height: auto; opacity: 0.1; filter: grayscale(1); margin-bottom: var(--s-7); }
  .footer-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: var(--s-6); padding-bottom: var(--s-6); }
  .footer-grid :global(.footer-logo) { width: 150px; margin-bottom: var(--s-3); }
  .footer-h { font-size: var(--t-sm); font-weight: 600; color: var(--muted); margin-bottom: var(--s-3); letter-spacing: 0; }
  .footer-list { list-style: none; display: grid; gap: var(--s-2); font-size: var(--t-sm); }
  .footer-list a { text-decoration: none; }
  .footer-list a:hover { text-decoration: underline; }
  .footer-bottom {
    display: flex; justify-content: space-between; gap: var(--s-4); flex-wrap: wrap;
    border-top: 1px solid var(--line); padding-block: var(--s-5);
  }
  @media (max-width: 860px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } }

  .quickbar { display: none; }
  @media (max-width: 640px) {
    .quickbar {
      display: grid; grid-template-columns: repeat(3, 1fr);
      position: fixed; inset: auto 0 0 0; z-index: 40;
      background: var(--navy); color: #fff;
      padding-bottom: env(safe-area-inset-bottom);
    }
    .quickbar a {
      display: flex; align-items: center; justify-content: center; gap: var(--s-2);
      min-height: 56px; text-decoration: none; font-weight: 600; font-size: 0.95rem;
    }
    .quickbar a + a { border-left: 1px solid rgb(255 255 255 / 0.16); }
    .quickbar svg { width: 18px; height: 18px; }
    .site-footer { padding-bottom: 56px; }
  }
</style>
