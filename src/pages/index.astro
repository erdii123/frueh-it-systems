---
import Base from '../layouts/Base.astro';
import Fallfinder from '../components/Fallfinder.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import nick from '../assets/nick-frueh.jpg';
import glas from '../assets/hero-glas.webp';
import site from '../data/site.json';
import p from '../data/preise.json';
import { faqStart as faq } from '../data/faq';
import Leistungen from '../components/Leistungen.astro';
import PreiseFirma from '../components/PreiseFirma.astro';
import PreisePrivat from '../components/PreisePrivat.astro';
import Vertrauen from '../components/Vertrauen.astro';
import Ueber from '../components/Ueber.astro';
import Ablauf from '../components/Ablauf.astro';
import Faq from '../components/Faq.astro';
import Kontakt from '../components/Kontakt.astro';

const title = 'IT-Support Winterthur & Frauenfeld | Früh Systems';
const description =
  'Persönlicher IT-Support von Nick Früh für Private und KMU: Computer, E-Mail, WLAN, Microsoft 365. Vor Ort in Winterthur und Frauenfeld, Fernwartung schweizweit.';



const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': 'https://www.frueh-systems.ch/#business',
      name: site.name,
      url: 'https://www.frueh-systems.ch/',
      image: 'https://www.frueh-systems.ch/og-frueh-systems.jpg',
      logo: 'https://www.frueh-systems.ch/logo-frueh-systems.png',
      telephone: site.phoneIntl,
      email: site.email,
      founder: { '@type': 'Person', name: site.owner },
      address: { '@type': 'PostalAddress', streetAddress: site.street, postalCode: site.zip, addressLocality: site.city, addressRegion: 'TG', addressCountry: 'CH' },
      areaServed: [{ '@type': 'City', name: 'Winterthur' }, { '@type': 'City', name: 'Frauenfeld' }, { '@type': 'Country', name: 'Schweiz' }],
      priceRange: 'CHF 90–140',
      vatID: site.uid,
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<Base title={title} description={description} schema={schema}>
  <!-- Hero -->
  <section class="hero on-dark">
    <div class="hero-art" aria-hidden="true">
      <div class="hero-move">
        <Image src={glas} alt="" widths={[768, 1280, 1536]} sizes="(max-width: 900px) 150vw, 78vw" loading="eager" fetchpriority="high" />
      </div>
      <span class="hero-glow hero-glow-a"></span>
      <span class="hero-glow hero-glow-b"></span>
    </div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>IT, die einfach läuft.</h1>
        <p class="hero-sub">Persönlicher IT-Support für Private und KMU in Winterthur, Frauenfeld und Umgebung. Per Fernwartung in der ganzen Schweiz.</p>
        <div class="hero-person">
          <Image src={nick} alt="" width={56} height={56} densities={[1, 2]} class="hero-avatar" loading="eager" />
          <div>
            <p class="hero-name">Nick Früh, Ihr direkter Ansprechpartner</p>
            <a href={site.google.url} rel="noopener" class="stars-link"><span class="stars" aria-hidden="true">★★★★★</span> {site.google.rating} auf Google</a>
          </div>
        </div>
      </div>
      <Fallfinder />
    </div>
    <div class="wrap">
      <div class="hero-foot">
        <ul class="hero-facts">
          <li>{site.experienceYears} Jahre IT-Erfahrung</li>
          <li>Ein direkter Ansprechpartner</li>
          <li>Klare Kosten vor dem Start</li>
        </ul>
        <button type="button" class="motion-toggle" aria-pressed="true" data-motion-toggle>
          <svg class="mt-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="mt-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10-6.5z" fill="currentColor"/></svg>
          <span>Bewegung</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Zielgruppen -->
  <section class="section audience" aria-label="Für Unternehmen und Privatpersonen">
    <div class="wrap audience-grid">
      <article class="aud aud-firma" id="unternehmen">
        <Icon name="building" class="aud-icon" />
        <h2>Ihr Geschäft im Fokus. Ihre IT in guten Händen.</h2>
        <ul class="checks">
          <li>Einzelauftrag oder laufende Betreuung</li>
          <li>Ein Ansprechpartner, auch für Ihre Anbieter</li>
          <li>Microsoft 365, Backup, Netzwerk</li>
        </ul>
        <div class="aud-foot">
          <a class="btn btn-primary" href="/it-support/">Für Unternehmen</a>
          <a class="small" href="#preise" data-preise="firma">ab CHF {p.firma.stunde} pro Stunde</a>
        </div>
      </article>
      <article class="aud aud-privat" id="privat">
        <Icon name="home" class="aud-icon" />
        <h2>Technik soll helfen. Nicht den Tag bestimmen.</h2>
        <ul class="checks">
          <li>PC- und Laptop-Reparaturen</li>
          <li>E-Mail, WLAN und Drucker</li>
          <li>Erklärungen, die Sie verstehen</li>
        </ul>
        <div class="aud-foot">
          <a class="btn btn-primary" href="/privat/">Für Privatpersonen</a>
          <a class="small" href="#preise" data-preise="privat">Fernwartung ab CHF {p.privat.fernwartung.preis}</a>
        </div>
      </article>
    </div>
  </section>

  <Leistungen />

  <!-- Preise -->
  <section class="section pricing" id="preise">
    <div class="wrap">
      <div class="pricing-head">
        <h2>Gute IT. Ein gutes Gefühl beim Preis.</h2>
        <div class="switch" role="tablist" aria-label="Preise für">
          <button type="button" role="tab" id="ptab-firma" aria-controls="ppanel-firma" aria-selected="true" tabindex="0">Unternehmen</button>
          <button type="button" role="tab" id="ptab-privat" aria-controls="ppanel-privat" aria-selected="false" tabindex="-1">Privatpersonen</button>
        </div>
      </div>
      <div role="tabpanel" id="ppanel-firma" aria-labelledby="ptab-firma" class="ppanel"><PreiseFirma /></div>
      <div role="tabpanel" id="ppanel-privat" aria-labelledby="ptab-privat" class="ppanel" hidden><PreisePrivat /></div>
    </div>
  </section>

  <Vertrauen />
  <Ueber />
  <Ablauf />
  <Faq items={faq} />
  <Kontakt />
</Base>

<script>
  import { tabs } from '../scripts/tabs';
  const priceList = document.querySelector<HTMLElement>('.switch');
  const selectPrice = priceList ? tabs(priceList) : null;
  document.querySelectorAll<HTMLAnchorElement>('[data-preise]').forEach((a) =>
    a.addEventListener('click', () => {
      const t = document.getElementById(`ptab-${a.dataset.preise}`);
      if (t && selectPrice) selectPrice(t);
    })
  );

  // Hero: ruhige Endlos-Bewegung, Schalter, Pause ausserhalb des Sichtbereichs
  const hero = document.querySelector<HTMLElement>('.hero');
  const rm = matchMedia('(prefers-reduced-motion: reduce)');
  if (hero) {
    const btn = hero.querySelector<HTMLButtonElement>('[data-motion-toggle]')!;
    let saved: string | null = null;
    try { saved = localStorage.getItem('fs-motion'); } catch {}
    const apply = (on: boolean) => {
      hero.classList.toggle('motion-off', !on);
      btn.setAttribute('aria-pressed', String(on));
      btn.setAttribute('aria-label', on ? 'Bewegung im Hintergrund anhalten' : 'Bewegung im Hintergrund starten');
    };
    apply(saved ? saved === 'on' : !rm.matches);
    btn.addEventListener('click', () => {
      const on = btn.getAttribute('aria-pressed') !== 'true';
      apply(on);
      try { localStorage.setItem('fs-motion', on ? 'on' : 'off'); } catch {}
    });
    rm.addEventListener('change', () => { if (!saved) apply(!rm.matches); });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => hero.classList.toggle('offscreen', !e.isIntersecting)).observe(hero);
    }
  }
  if (hero && matchMedia('(pointer: fine)').matches) {
    hero.addEventListener('pointermove', (e) => {
      if (hero.classList.contains('motion-off')) return;
      const r = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', `${((e.clientX - r.left) / r.width - 0.5) * -18}px`);
      hero.style.setProperty('--my', `${((e.clientY - r.top) / r.height - 0.5) * -12}px`);
    });
    hero.addEventListener('pointerleave', () => { hero.style.setProperty('--mx', '0px'); hero.style.setProperty('--my', '0px'); });
  }

</script>
