---
import Base from '../layouts/Base.astro';
import Fallfinder from '../components/Fallfinder.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import nick from '../assets/nick-frueh.jpg';
import glas from '../assets/hero-glas.webp';
import site from '../data/site.json';
import p from '../data/preise.json';

const title = 'IT-Support Winterthur & Frauenfeld | Früh Systems';
const description =
  'Persönlicher IT-Support von Nick Früh für Private und KMU: Computer, E-Mail, WLAN, Microsoft 365. Vor Ort in Winterthur und Frauenfeld, Fernwartung schweizweit.';

const leistungen = [
  { id: 'arbeitsplatz', icon: 'monitor', tab: 'IT-Support und Arbeitsplätze', titel: 'Ein Arbeitsplatz, der für Sie arbeitet.',
    punkte: ['PCs, Programme und Drucker einrichten', 'Benutzerzugänge und Updates betreuen', 'Daten auf neue Geräte übernehmen'],
    mitte: 'Ihr Arbeitsplatz', teile: ['Geräte', 'Programme', 'Zugänge'] },
  { id: 'm365', icon: 'apps', tab: 'Microsoft 365 und E-Mail', titel: 'Ihr Team. Gut verbunden.',
    punkte: ['Outlook, Teams und OneDrive einrichten', 'Benutzerwechsel sauber begleiten', 'Konten, Lizenzen und Berechtigungen ordnen'],
    mitte: 'Microsoft 365', teile: ['Outlook', 'Teams', 'OneDrive'] },
  { id: 'backup', icon: 'backup', tab: 'Backup und Wiederherstellung', titel: 'Wichtiges sichern. Rückweg vorbereiten.',
    punkte: ['Wichtige Daten erkennen', 'Sicherungen planen und prüfen', 'Wiederherstellung vorbereiten'],
    mitte: 'Ihre Datensicherung', teile: ['Daten', 'Sicherung', 'Rückweg'] },
  { id: 'sicherheit', icon: 'shield', tab: 'IT-Sicherheit', titel: 'Mehr Schutz. Weniger offene Fragen.',
    punkte: ['Mehrstufige Anmeldung einrichten', 'Updates und Berechtigungen prüfen', 'Zugriffe sinnvoll begrenzen'],
    mitte: 'Ihr Grundschutz', teile: ['Anmeldung', 'Updates', 'Rechte'] },
  { id: 'netzwerk', icon: 'wifi', tab: 'Netzwerk und WLAN', titel: 'Verbindung, wo Sie sie brauchen.',
    punkte: ['Router, Switches und WLAN', 'Abdeckung und Verbindung verbessern', 'Gästezugänge und VPN'],
    mitte: 'Ihr Netzwerk', teile: ['Router', 'WLAN', 'Gäste'] },
  { id: 'geraete', icon: 'laptop', tab: 'Geräte und Hardware', titel: 'Das passende Gerät, sauber eingerichtet.',
    punkte: ['Fehler an PC und Laptop finden', 'Reparatur oder neues Gerät abwägen', 'Einrichten und Daten übernehmen'],
    mitte: 'Ihr Gerät', teile: ['Diagnose', 'Entscheid', 'Einrichtung'] },
  { id: 'testing', icon: 'test', tab: 'Software-Testing', titel: 'Fehler finden, bevor Ihre Kunden es tun.',
    punkte: ['Funktionen und Abläufe manuell testen', 'Nachvollziehbare Fehlerberichte', 'Nachtests nach Korrekturen'],
    mitte: 'Ihre Anwendung', teile: ['Test', 'Bericht', 'Nachtest'] },
];

const faq = [
  { q: 'Ich weiss nicht genau, was das Problem ist.', a: 'Das müssen Sie nicht. Beschreiben Sie, was Sie beobachten. Ich kläre die Ursache und den nächsten Schritt.' },
  { q: 'Wie funktioniert die Fernwartung?', a: 'Der Computer muss starten und online sein. Die Verbindung beginnt erst nach Ihrer Freigabe, Sie sehen jeden Schritt und können jederzeit beenden.' },
  { q: 'Kann ich einmalig Hilfe anfragen?', a: 'Ja. Firmen nutzen Support nach Aufwand ohne Bindung. Privatpersonen wählen Fernwartung, vor Ort oder das 3-Stunden-Guthaben.' },
  { q: 'Was passiert, bevor Kosten entstehen?', a: 'Vorgehen und mögliche Zusatzkosten bespreche ich vorher. Ich beginne erst nach Ihrer Freigabe.' },
  { q: 'Wie schnell bekomme ich Hilfe?', a: 'Nach Dringlichkeit und Verfügbarkeit. Feste Reaktionszeiten vereinbare ich bei Bedarf mit Ihnen.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': 'https://www.frueh-systems.ch/#business',
      name: site.name,
      url: 'https://www.frueh-systems.ch/',
      image: 'https://www.frueh-systems.ch/og-frueh-systems.jpg',
      logo: 'https://www.frueh-systems.ch/logo-frueh-systems.png',
      telephone: site.phoneIntl,
      email: site.email,
      founder: { '@type': 'Person', name: site.owner },
      address: { '@type': 'PostalAddress', streetAddress: site.street, postalCode: site.zip, addressLocality: site.city, addressRegion: 'TG', addressCountry: 'CH' },
      areaServed: [{ '@type': 'City', name: 'Winterthur' }, { '@type': 'City', name: 'Frauenfeld' }, { '@type': 'Country', name: 'Schweiz' }],
      priceRange: 'CHF 90–140',
      vatID: site.uid,
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<Base title={title} description={description} schema={schema}>
  <!-- Hero -->
  <section class="hero on-dark">
    <div class="hero-art" aria-hidden="true">
      <Image src={glas} alt="" widths={[768, 1280, 1536]} sizes="(max-width: 900px) 150vw, 78vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>IT, die einfach läuft.</h1>
        <p class="hero-sub">Persönlicher IT-Support für Private und KMU in Winterthur, Frauenfeld und Umgebung. Per Fernwartung in der ganzen Schweiz.</p>
        <div class="hero-person">
          <Image src={nick} alt="" width={56} height={56} densities={[1, 2]} class="hero-avatar" loading="eager" />
          <div>
            <p class="hero-name">Nick Früh, Ihr direkter Ansprechpartner</p>
            <a href={site.google.url} rel="noopener" class="stars-link"><span class="stars" aria-hidden="true">★★★★★</span> {site.google.rating} auf Google</a>
          </div>
        </div>
      </div>
      <Fallfinder />
    </div>
    <div class="wrap">
      <ul class="hero-facts">
        <li>{site.experienceYears} Jahre IT-Erfahrung</li>
        <li>Ein direkter Ansprechpartner</li>
        <li>Klare Kosten vor dem Start</li>
      </ul>
    </div>
  </section>

  <!-- Zielgruppen -->
  <section class="section audience" aria-label="Für Unternehmen und Privatpersonen">
    <div class="wrap audience-grid">
      <article class="aud aud-firma" id="unternehmen">
        <Icon name="building" class="aud-icon" />
        <h2>Ihr Geschäft im Fokus. Ihre IT in guten Händen.</h2>
        <ul class="checks">
          <li>Einzelauftrag oder laufende Betreuung</li>
          <li>Ein Ansprechpartner, auch für Ihre Anbieter</li>
          <li>Microsoft 365, Backup, Netzwerk</li>
        </ul>
        <div class="aud-foot">
          <a class="btn btn-primary" href="#preise" data-preise="firma">Für Unternehmen</a>
          <span class="small">ab CHF {p.firma.stunde} pro Stunde</span>
        </div>
      </article>
      <article class="aud aud-privat" id="privat">
        <Icon name="home" class="aud-icon" />
        <h2>Technik soll helfen. Nicht den Tag bestimmen.</h2>
        <ul class="checks">
          <li>PC- und Laptop-Reparaturen</li>
          <li>E-Mail, WLAN und Drucker</li>
          <li>Erklärungen, die Sie verstehen</li>
        </ul>
        <div class="aud-foot">
          <a class="btn btn-primary" href="#preise" data-preise="privat">Für Privatpersonen</a>
          <span class="small">Fernwartung ab CHF {p.privat.fernwartung.preis}</span>
        </div>
      </article>
    </div>
  </section>

  <!-- Leistungen -->
  <section class="services on-dark" id="leistungen">
    <div class="wrap">
      <div class="services-head">
        <h2>Ihre IT kann mehr.</h2>
        <p>Sieben Bereiche, ein Ansprechpartner.</p>
      </div>
      <div class="services-grid">
        <div class="service-tabs" role="tablist" aria-label="Leistungen" aria-orientation="vertical">
          {leistungen.map((l, i) => (
            <button type="button" role="tab" id={`tab-${l.id}`} aria-controls={`panel-${l.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <Icon name={l.icon} />
              <span>{l.tab}</span>
            </button>
          ))}
        </div>
        {leistungen.map((l, i) => (
          <div class="service-panel" role="tabpanel" id={`panel-${l.id}`} aria-labelledby={`tab-${l.id}`} hidden={i !== 0}>
            <div class="sp-copy">
              <h3>{l.titel}</h3>
              <ul class="checks">{l.punkte.map((pt) => <li>{pt}</li>)}</ul>
              <a class="btn btn-lila" href="#anfrage" data-thema={l.tab}>Dieses Thema besprechen</a>
            </div>
            <div class="sp-diagram" aria-hidden="true">
              <span class="sp-root"><Icon name={l.icon} />{l.mitte}</span>
              <span class="sp-lines"></span>
              <span class="sp-leaves">{l.teile.map((t) => <span>{t}</span>)}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Preise -->
  <section class="section pricing" id="preise">
    <div class="wrap">
      <div class="pricing-head">
        <h2>Gute IT. Ein gutes Gefühl beim Preis.</h2>
        <div class="switch" role="tablist" aria-label="Preise für">
          <button type="button" role="tab" id="ptab-firma" aria-controls="ppanel-firma" aria-selected="true" tabindex="0">Unternehmen</button>
          <button type="button" role="tab" id="ptab-privat" aria-controls="ppanel-privat" aria-selected="false" tabindex="-1">Privatpersonen</button>
        </div>
      </div>

      <div role="tabpanel" id="ppanel-firma" aria-labelledby="ptab-firma" class="ppanel">
        <div class="price-grid">
          <article class="price">
            <h3>Support nach Aufwand</h3>
            <p class="amount"><span class="cur">CHF</span>{p.firma.stunde}</p>
            <p class="per">pro Stunde, in 15-Minuten-Schritten</p>
            <ul class="checks">
              <li>Remote oder vor Ort</li>
              <li>Keine monatlichen Kosten</li>
              <li>Vor Ort: mindestens 1 Stunde</li>
            </ul>
            <a class="btn btn-ghost" href="#anfrage" data-thema="Support nach Aufwand" data-typ="firma">Support anfragen</a>
          </article>
          <article class="price price-dark on-dark">
            <h3>Betreuter Arbeitsplatz</h3>
            <p class="amount"><span class="cur">ab CHF</span>{p.firma.arbeitsplatz}</p>
            <p class="per">pro Arbeitsplatz und Monat</p>
            <ul class="checks">
              <li>Monitoring und Patch-Management</li>
              <li>Inventar und IT-Dokumentation</li>
              <li>Microsoft-365-Basisadministration</li>
              <li>{p.firma.poolMinuten} gepoolte Supportminuten je Arbeitsplatz</li>
            </ul>
            <a class="btn btn-lila" href="#anfrage" data-thema="Betreute Arbeitsplätze" data-typ="firma">Betreuung besprechen</a>
          </article>
        </div>

        <div class="calc" data-calc data-preis={parseInt(p.firma.arbeitsplatz)} data-minuten={p.firma.poolMinuten}>
          <div class="calc-in">
            <label for="calc-n" class="calc-label">Wie viele Arbeitsplätze?</label>
            <div class="stepper">
              <button type="button" data-step="-1" aria-label="Ein Arbeitsplatz weniger">−</button>
              <input id="calc-n" type="number" inputmode="numeric" min="1" max="100" value="5" />
              <button type="button" data-step="1" aria-label="Ein Arbeitsplatz mehr">+</button>
            </div>
            <input type="range" min="1" max="100" value="5" aria-label="Arbeitsplätze einstellen" data-range />
            <div class="presets" role="group" aria-label="Schnellwahl">
              {[1, 5, 10, 25].map((n) => <button type="button" data-preset={n} aria-pressed={n === 5 ? 'true' : 'false'}>{n === 1 ? 'Solo' : `${n} Personen`}</button>)}
            </div>
          </div>
          <div class="calc-out" aria-live="polite">
            <p class="small muted">Unverbindlicher Richtwert</p>
            <p class="calc-price" data-out-preis>ab CHF 495.–</p>
            <p class="small muted"><span data-out-text>pro Monat, 150 gepoolte Supportminuten</span></p>
          </div>
        </div>
        <p class="fine">Genauer Umfang nach einer kurzen Bestandsaufnahme. Onboarding, Lizenzen, Vor-Ort-Termine, Projekte, Server und NAS separat. Keine Flatrate, keine feste Reaktionszeit.</p>
      </div>

      <div role="tabpanel" id="ppanel-privat" aria-labelledby="ptab-privat" class="ppanel" hidden>
        <div class="price-grid">
          <article class="price">
            <h3>Fernwartung</h3>
            <p class="amount"><span class="cur">CHF</span>{p.privat.fernwartung.preis}</p>
            <p class="per">Mindestpauschale, bis 45 Minuten</p>
            <ul class="checks">
              <li>PC, E-Mail, Programme</li>
              <li>Zugriff nur mit Ihrer Freigabe</li>
              <li>Danach CHF {p.privat.weitere15} je 15 Minuten</li>
            </ul>
            <a class="btn btn-ghost" href="#anfrage" data-thema="Fernwartung privat" data-typ="privat">Fernwartung anfragen</a>
          </article>
          <article class="price price-dark on-dark">
            <h3>Vor Ort und Reparatur</h3>
            <p class="amount"><span class="cur">CHF</span>{p.privat.vorOrt.preis}</p>
            <p class="per">Mindestpauschale, bis 45 Minuten</p>
            <ul class="checks">
              <li>PC, Laptop, WLAN, Drucker</li>
              <li>Neue Geräte und Datenübernahme</li>
              <li>Danach CHF {p.privat.weitere15} je 15 Minuten</li>
            </ul>
            <a class="btn btn-lila" href="#anfrage" data-thema="Termin vor Ort privat" data-typ="privat">Termin anfragen</a>
          </article>
        </div>
        <div class="credit">
          <div>
            <h3>3 Stunden Support. Flexibel nutzbar.</h3>
            <p class="small muted">{p.privat.guthaben.gueltig} gültig, in 15-Minuten-Schritten, kein Abo</p>
          </div>
          <p class="credit-price">CHF {p.privat.guthaben.preis}</p>
          <a class="btn btn-ghost" href="#anfrage" data-thema="3-Stunden-Guthaben" data-typ="privat">Guthaben anfragen</a>
        </div>
        <p class="fine">Anfahrt, Hardware, Lizenzen und Material nach Rücksprache separat.</p>
      </div>
    </div>
  </section>

  <!-- Vertrauen -->
  <section class="trust" aria-label="Koordination und Sicherheit">
    <div class="wrap trust-grid">
      <div class="trust-item">
        <Icon name="link" />
        <div>
          <h2>Schluss mit dem Zuständigkeits-Pingpong.</h2>
          <p>Ich kläre mit Internetanbieter, Microsoft und Softwarefirma, wer zuständig ist.</p>
        </div>
      </div>
      <div class="trust-item" id="fernwartung">
        <Icon name="shield" />
        <div>
          <h2>Kein unangekündigter Zugriff.</h2>
          <p>Öffnen Sie <a href={site.anydesk} rel="noopener">AnyDesk</a> nur zum vereinbarten Termin, nie wegen eines unerwarteten Anrufs.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Über mich -->
  <section class="section about" id="ueber-mich">
    <div class="wrap about-grid">
      <figure class="about-photo">
        <Image src={nick} alt="Nick Früh, Inhaber von Früh Systems" width={520} widths={[360, 520, 768]} sizes="(max-width: 760px) 100vw, 460px" />
        <figcaption><strong>Nick Früh</strong><span>Ihr persönlicher IT-Ansprechpartner</span></figcaption>
      </figure>
      <div class="about-copy">
        <h2>Hinter Ihrer IT steht ein Mensch.</h2>
        <p class="lead">Hallo, ich bin Nick Früh. Seit {site.experienceYears} Jahren in der IT. Ich höre zu, erkläre verständlich und setze erst nach Ihrer Freigabe um.</p>
        <p class="motto">Zuerst verstehen. Dann sinnvoll lösen.</p>
        <dl class="numbers">
          <div><dt>Jahre IT-Erfahrung</dt><dd>{site.experienceYears}</dd></div>
          <div><dt>direkter Ansprechpartner</dt><dd>1</dd></div>
          <div><dt>auf Google</dt><dd>{site.google.rating}</dd></div>
        </dl>
        <ul class="quotes">
          {site.google.quotes.map((q) => <li><blockquote>«{q.text}»</blockquote><span class="small muted">{q.author}</span></li>)}
        </ul>
        <a href={site.google.url} rel="noopener" class="small quotes-link">Bewertungen auf Google lesen</a>
      </div>
    </div>
  </section>

  <!-- Ablauf -->
  <section class="process">
    <div class="wrap">
      <h2>Einfach anfangen.</h2>
      <ol class="steps">
        <li><h3>Sie erzählen.</h3><p>Was nicht funktioniert. Fachbegriffe braucht es nicht.</p></li>
        <li><h3>Ich kläre.</h3><p>Weg, Aufwand und Kosten, bevor ich beginne.</p></li>
        <li><h3>Ihre IT läuft weiter.</h3><p>Nach Ihrer Freigabe, nachvollziehbar übergeben.</p></li>
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="fragen">
    <div class="wrap faq-grid">
      <h2>Noch eine Frage?</h2>
      <div class="faq">
        {faq.map((f) => (
          <details name="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Anfrage -->
  <section class="contact on-dark" id="anfrage">
    <div class="wrap contact-grid">
      <div class="contact-intro">
        <h2>Ein Gespräch genügt.</h2>
        <p class="contact-lead">Beschreiben Sie kurz Ihr Anliegen. Ich melde mich persönlich.</p>
        <a class="contact-phone" href={site.phoneHref}><Icon name="phone" />{site.phoneDisplay}</a>
        <ul class="contact-links">
          <li><a href={site.whatsapp} rel="noopener"><Icon name="chat" />WhatsApp schreiben</a></li>
          <li><a href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a></li>
        </ul>
      </div>

      <form class="form" name="anfrage" method="POST" action="/danke/" data-netlify="true" netlify-honeypot="bot-feld" novalidate>
        <input type="hidden" name="form-name" value="anfrage" />
        <p class="visually-hidden"><label>Nicht ausfüllen <input name="bot-feld" tabindex="-1" autocomplete="off" /></label></p>

        <fieldset class="field">
          <legend>Anfrage als <span aria-hidden="true">*</span></legend>
          <div class="seg-form">
            <label><input type="radio" name="kundentyp" value="Privatperson" required /><span>Privatperson</span></label>
            <label><input type="radio" name="kundentyp" value="Selbständig" /><span>Selbständig</span></label>
            <label><input type="radio" name="kundentyp" value="Unternehmen oder KMU" /><span>Unternehmen oder KMU</span></label>
          </div>
          <p class="error" data-error-for="kundentyp" hidden>Bitte wählen Sie aus, für wen die Anfrage ist.</p>
        </fieldset>

        <div class="row">
          <div class="field">
            <label for="f-name">Name <span aria-hidden="true">*</span></label>
            <input id="f-name" name="name" autocomplete="name" required aria-describedby="e-name" />
            <p class="error" id="e-name" data-error-for="name" hidden>Bitte geben Sie Ihren Namen an.</p>
          </div>
          <div class="field">
            <label for="f-firma">Firma <span class="opt">(optional)</span></label>
            <input id="f-firma" name="firma" autocomplete="organization" />
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label for="f-email">E-Mail <span aria-hidden="true">*</span></label>
            <input id="f-email" name="email" type="email" autocomplete="email" required aria-describedby="e-email" />
            <p class="error" id="e-email" data-error-for="email" hidden>Bitte geben Sie eine gültige E-Mail-Adresse an.</p>
          </div>
          <div class="field">
            <label for="f-tel">Telefon <span class="opt">(optional)</span></label>
            <input id="f-tel" name="telefon" type="tel" autocomplete="tel" />
          </div>
        </div>
        <div class="field">
          <label for="f-msg">Worum geht es? <span aria-hidden="true">*</span></label>
          <textarea id="f-msg" name="nachricht" rows="4" required aria-describedby="e-msg" placeholder="Was funktioniert nicht oder soll besser werden?"></textarea>
          <p class="error" id="e-msg" data-error-for="nachricht" hidden>Bitte beschreiben Sie kurz Ihr Anliegen.</p>
        </div>
        <p class="small form-note">Bitte keine Passwörter senden. Es gilt die <a href={site.privacyUrl}>Datenschutzerklärung</a>.</p>
        <button class="btn btn-lila" type="submit">Anfrage senden</button>
      </form>
    </div>
  </section>
</Base>

<script>
  // Tabs (Leistungen und Preise)
  function tabs(list: HTMLElement, onSelect?: (tab: HTMLElement) => void) {
    const items = [...list.querySelectorAll<HTMLElement>('[role="tab"]')];
    const select = (tab: HTMLElement, focus = false) => {
      items.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
      onSelect?.(tab);
    };
    items.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const vertical = list.getAttribute('aria-orientation') === 'vertical';
        const prev = vertical ? 'ArrowUp' : 'ArrowLeft';
        const next = vertical ? 'ArrowDown' : 'ArrowRight';
        let j = -1;
        if (e.key === prev) j = (i - 1 + items.length) % items.length;
        else if (e.key === next) j = (i + 1) % items.length;
        else if (e.key === 'Home') j = 0;
        else if (e.key === 'End') j = items.length - 1;
        if (j >= 0) { e.preventDefault(); select(items[j], true); }
      });
    });
    return select;
  }

  const serviceList = document.querySelector<HTMLElement>('.service-tabs');
  if (serviceList) {
    const mq = matchMedia('(max-width: 860px)');
    const orient = () => serviceList.setAttribute('aria-orientation', mq.matches ? 'horizontal' : 'vertical');
    orient(); mq.addEventListener('change', orient);
    tabs(serviceList, (tab) => {
      if (mq.matches) serviceList.scrollTo({ left: tab.offsetLeft - serviceList.offsetLeft - 8, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
  }

  const priceList = document.querySelector<HTMLElement>('.switch');
  const selectPrice = priceList ? tabs(priceList) : null;
  document.querySelectorAll<HTMLAnchorElement>('[data-preise]').forEach((a) =>
    a.addEventListener('click', () => {
      const t = document.getElementById(`ptab-${a.dataset.preise}`);
      if (t && selectPrice) selectPrice(t);
    })
  );

  // Rechner
  const calc = document.querySelector<HTMLElement>('[data-calc]');
  if (calc) {
    const preis = Number(calc.dataset.preis), minuten = Number(calc.dataset.minuten);
    const num = calc.querySelector<HTMLInputElement>('#calc-n')!;
    const range = calc.querySelector<HTMLInputElement>('[data-range]')!;
    const fmt = new Intl.NumberFormat('de-CH');
    const set = (v: number) => {
      const n = Math.max(1, Math.min(100, Math.round(v) || 1));
      num.value = String(n); range.value = String(n);
      range.setAttribute('aria-valuetext', `${n} Arbeitsplätze`);
      calc.querySelector('[data-out-preis]')!.textContent = `ab CHF ${fmt.format(n * preis)}.–`;
      calc.querySelector('[data-out-text]')!.textContent = `pro Monat, ${fmt.format(n * minuten)} gepoolte Supportminuten`;
      calc.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.preset) === n)));
      calc.querySelector<HTMLButtonElement>('[data-step="-1"]')!.disabled = n <= 1;
      calc.querySelector<HTMLButtonElement>('[data-step="1"]')!.disabled = n >= 100;
    };
    num.addEventListener('change', () => set(Number(num.value)));
    range.addEventListener('input', () => set(Number(range.value)));
    calc.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => set(Number(num.value) + Number(b.dataset.step))));
    calc.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => set(Number(b.dataset.preset))));
    set(5);
  }

  // Hero: leichte Bewegung des Bildes mit der Maus
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero && matchMedia('(pointer: fine)').matches) {
    const rm = matchMedia('(prefers-reduced-motion: reduce)');
    hero.addEventListener('pointermove', (e) => {
      if (rm.matches) return;
      const r = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', `${((e.clientX - r.left) / r.width - 0.5) * -18}px`);
      hero.style.setProperty('--my', `${((e.clientY - r.top) / r.height - 0.5) * -12}px`);
    });
    hero.addEventListener('pointerleave', () => { hero.style.setProperty('--mx', '0px'); hero.style.setProperty('--my', '0px'); });
  }

  // Formular
  const form = document.querySelector<HTMLFormElement>('form[name="anfrage"]');
  if (form) {
    const msg = form.querySelector<HTMLTextAreaElement>('textarea[name="nachricht"]')!;
    const setTyp = (fuer: string) => {
      const v = fuer === 'firma' ? 'Unternehmen oder KMU' : 'Privatperson';
      const r = form.querySelector<HTMLInputElement>(`input[name="kundentyp"][value="${v}"]`);
      if (r) r.checked = true;
    };
    const prefill = (thema: string, fuer?: string) => {
      if (fuer) setTyp(fuer);
      if (!msg.value.trim() || msg.dataset.prefilled === 'true') {
        msg.value = `Thema: ${thema}\n\n`;
        msg.dataset.prefilled = 'true';
      }
      setTimeout(() => msg.focus({ preventScroll: true }), 450);
    };
    document.addEventListener('anfrage:vorbelegen', (e) => {
      const { fuer, thema } = (e as CustomEvent).detail;
      prefill(thema, fuer);
    });
    document.querySelectorAll<HTMLAnchorElement>('[data-thema]').forEach((a) =>
      a.addEventListener('click', () => {
        let thema = a.dataset.thema!;
        if (thema === 'Betreute Arbeitsplätze') {
          const n = document.querySelector<HTMLInputElement>('#calc-n')?.value;
          if (n) thema = `Betreuung von ${n} Arbeitsplätzen`;
        }
        prefill(thema, a.dataset.typ);
      })
    );

    const show = (name: string, on: boolean) => {
      const el = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (el) el.hidden = !on;
      form.querySelectorAll<HTMLInputElement>(`[name="${name}"]`).forEach((i) => i.setAttribute('aria-invalid', String(on)));
    };
    const check = () => {
      let first: HTMLElement | null = null;
      ['kundentyp', 'name', 'email', 'nachricht'].forEach((n) => {
        const fields = form.querySelectorAll<HTMLInputElement>(`[name="${n}"]`);
        const valid = n === 'kundentyp' ? [...fields].some((f) => f.checked) : fields[0].checkValidity() && fields[0].value.trim() !== '';
        show(n, !valid);
        if (!valid && !first) first = fields[0];
      });
      return first as HTMLElement | null;
    };
    form.addEventListener('submit', (e) => {
      const first = check();
      if (first) { e.preventDefault(); first.focus(); }
    });
    form.addEventListener('input', (e) => {
      const n = (e.target as HTMLInputElement).name;
      const err = form.querySelector<HTMLElement>(`[data-error-for="${n}"]`);
      if (err && !err.hidden) check();
    });
  }
</script>

